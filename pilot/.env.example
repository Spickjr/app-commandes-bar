# Supabase → Connect → ORM (Prisma) → « Transaction pooler » (port 6543),
# en ajoutant &schema=pilot à la fin.
DATABASE_URL="postgresql://postgres.xxxx:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true&schema=pilot"
# Secret de session : générer avec `openssl rand -base64 32`
AUTH_SECRET=""
